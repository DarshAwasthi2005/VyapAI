# VyapAI environment configuration.
# Everything defaulting to "set it later" is optional — the app boots and all
# tests pass with NO external credentials (integrations fail loudly only when
# actually called). See docs/ZERO_COST_BLUEPRINT.md for where each free key
# comes from.

# --- Core (works as-is for local dev) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://vyapai:vyapai@db:5432/vyapai
SECRET_KEY=dev-insecure-key

# --- Vision/OCR — ALL FREE, pick one ---
# 1. Groq (recommended, free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
# 2. Gemini (free tier; NOTE: free-tier input may be used by Google to improve
#    products — never send real merchant PII on the free tier):
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 3. Ollama (self-hosted, no network at all): `ollama pull llama3.2-vision`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision

# --- Speech-to-text — ALL FREE ---
# Vosk self-hosted server (Apache-2.0 models, Hindi 42MB / Gujarati 100MB):
VOSK_ENDPOINT=
# Bhashini (free for PoC only — paid for production):
BHASHINI_API_KEY=
BHASHINI_ENDPOINT=
# AI4Bharat IndicWhisper self-hosted endpoint:
INDIC_WHISPER_ENDPOINT=

# --- Media storage: voice notes & bill photos ---
# local (default, dev) or r2 (10 GB free tier, needs `pip install boto3`)
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=.media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Messaging: pick a channel ---
# Telegram Bot — completely FREE, unlimited practical volume.
# Get a token from @BotFather; then setWebhook with the secret token below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# SMS login codes on the shop's real phone - Twilio (free trial credit,
# https://www.twilio.com/try-twilio). Copy Account SID + Auth Token from the
# console; TWILIO_PHONE_NUMBER is your trial sender number in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (setup free; template messages outside the 24h window
# cost ~₹0.115/utility in India): https://developers.facebook.com/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- UPI (free deep links; confirmation needs a PSP webhook) ---
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=

# --- GST via GSP / OCEN (keep empty until a partner is signed) ---
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_BASE_URL=
OCEN_LSP_ID=
OCEN_BASE_URL=
OCEN_API_KEY=

# --- Guardrails ---
MAX_AUTO_APPROVE_AMOUNT_INR=50000

# --- Email OTP (login option 2: sign in with email) ---
# Plain SMTP — works with any provider, incl. a free Gmail app-password.
# Set SMTP_HOST + SMTP_FROM (+ SMTP_USER/SMTP_PASSWORD for authenticated
# relays) and email OTPs are REALLY delivered; until then dev mode shows
# the code on screen (dev_echo), production refuses loud.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
