```env
# Copy to .env and fill in what you have. The app boots and serves /health
# and /docs with none of these set — each integration only fails when it's
# actually called, with a clear NotConfiguredError naming what's missing.

# --- Core ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://vyapai:vyapai@db:5432/vyapai
SECRET_KEY=change-me-in-production

# --- Guardrails ---
# Ledger entries above this INR amount always route to human approval,
# regardless of what the guardrail's arithmetic checks say.
MAX_AUTO_APPROVE_AMOUNT_INR=50000

# --- Speech: Bhashini (Govt of India multilingual API network) ---
BHASHINI_API_KEY=
BHASHINI_ENDPOINT=

# --- Speech: self-hosted Indic-Whisper (alternative to Bhashini) ---
INDIC_WHISPER_ENDPOINT=

# --- Vision/OCR for handwritten bills: free options (Gemini tried first) ---
# Gemini API — hosted, free tier, no credit card: get a key at
# https://aistudio.google.com/apikey. Leave blank to fall back
# to the local Ollama backend below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama — self-hosted fallback, zero signup, zero external calls, unlimited
# use, but slower and less accurate. Install: https://ollama.com/download
#   ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- UPI ---
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=

# --- GSTN e-way bill, via a licensed GSP (ClearTax / MasterGST / Cygnet / etc.) ---
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_BASE_URL=

# --- OCEN (requires LSP empanelment on a network like Setu/Yubi/Sahamati) ---
OCEN_LSP_ID=
OCEN_BASE_URL=
OCEN_API_KEY=
```