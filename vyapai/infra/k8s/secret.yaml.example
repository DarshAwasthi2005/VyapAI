# Template only — copy to secret.yaml (which is .gitignored), fill in real
# values, and `kubectl apply -f`. Never commit actual secrets to source
# control. In a real production setup, prefer a secrets manager (AWS
# Secrets Manager / GCP Secret Manager / HashiCorp Vault) synced via
# External Secrets Operator instead of raw Kubernetes Secret manifests.
apiVersion: v1
kind: Secret
metadata:
  name: vyapai-secrets
  namespace: vyapai
type: Opaque
stringData:
  DATABASE_URL: "postgresql+psycopg2://vyapai:CHANGE_ME@vyapai-db:5432/vyapai"
  SECRET_KEY: "CHANGE_ME"
  BHASHINI_API_KEY: ""
  # Vision/OCR: Gemini free tier (get a key at https://aistudio.google.com/apikey).
  # Leave blank to use the local Ollama fallback instead (see configmap.yaml for
  # OLLAMA_BASE_URL / OLLAMA_VISION_MODEL) — Ollama needs no key, so it isn't a secret.
  GEMINI_API_KEY: ""
  WHATSAPP_TOKEN: ""
  WHATSAPP_VERIFY_TOKEN: ""
  WHATSAPP_APP_SECRET: ""
  UPI_PAYEE_VPA: ""
  GSP_CLIENT_ID: ""
  GSP_CLIENT_SECRET: ""
  OCEN_LSP_ID: ""
  OCEN_API_KEY: ""
