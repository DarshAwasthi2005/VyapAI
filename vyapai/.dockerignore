# Keep the build context small and keep secrets/local state out of the image.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets and environment
.env
.env.*
!.env.example

# Local databases and runtime artifacts
*.db
*.sqlite3
*.log
.telegram-offset
.media
.asr
*.wav
*.mp3

# Tests / docs are not needed inside the runtime image
tests
docs
infra
.github
docker-compose.yml
Dockerfile
.dockerignore
Makefile
README.md
